<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ETLModule.Desktop.ViewModels"
        x:Class="ETLModule.Desktop.Views.InputDialogWindow"
        x:DataType="vm:InputDialogViewModel"
        Title="{Binding Title}"
        Width="400" Height="200"
        Icon="/Assets/avalonia-logo.ico"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SystemRegionBrush}">

    <Border Padding="25" BorderBrush="{DynamicResource SystemChromeMediumBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
            
            <TextBox Grid.Row="1" 
                     Text="{Binding InputText}" 
                     PlaceholderText="{Binding Watermark}" 
                     VerticalAlignment="Center" 
                     FontSize="16" 
                     Padding="10"/>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                <Button Content="Отмена" Click="CancelButton_Click" Padding="15,8"/>
                <Button Content="ОК" Click="OkButton_Click" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" Foreground="{DynamicResource SystemRegionBrush}" Padding="20,8"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>